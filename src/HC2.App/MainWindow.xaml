<Window x:Class="HC2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:HC2.App.Converters"
        xmlns:core="clr-namespace:HC2.Core.Serial;assembly=HC2.Core"
        Title="HC2 — COM Port Explorer"
        Height="720" Width="1160"
        MinHeight="500" MinWidth="860"
        Background="{StaticResource SurfaceAlt}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
        <conv:EmptyTextConverter x:Key="EmptyText" />
        <conv:InverseBooleanConverter x:Key="Not" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="SmallInput" TargetType="TextBox">
            <Setter Property="Width" Value="52" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="320" MinHeight="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Port toolbar -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}" />

            <CheckBox Content="Auto-refresh on device change"
                      IsChecked="{Binding AutoRefresh}"
                      Margin="0,0,20,0" />

            <CheckBox Content="Probe whether each port is free"
                      IsChecked="{Binding ProbeAvailability}"
                      ToolTip="Briefly opens every port. This toggles DTR/RTS, so leave it off if a connected device might react."
                      Margin="0,0,20,0" />

            <TextBlock />
        </DockPanel>

        <!-- Port list -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <DataGrid ItemsSource="{Binding Ports}"
                          SelectedItem="{Binding SelectedPort}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource Border}"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="Transparent"
                          SelectionMode="Single"
                          CanUserResizeRows="False"
                          RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Port"
                                            Binding="{Binding PortName}"
                                            Width="80"
                                            FontWeight="SemiBold" />

                        <DataGridTextColumn Header="Device"
                                            Binding="{Binding FriendlyName, Converter={StaticResource EmptyText}}"
                                            Width="*" />

                        <DataGridTextColumn Header="Manufacturer"
                                            Binding="{Binding Manufacturer, Converter={StaticResource EmptyText}}"
                                            Width="180" />

                        <DataGridTemplateColumn Header="Available" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold">
                                        <!-- Text is set through the style, not locally: a locally-set
                                             property beats a style trigger, so a local Text binding would
                                             make the triggers below unable to relabel anything. -->
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Availability}" />
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Availability}" Value="{x:Static core:PortAvailability.Unknown}">
                                                        <Setter Property="Text" Value="—" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Availability}" Value="{x:Static core:PortAvailability.Free}">
                                                        <Setter Property="Foreground" Value="{StaticResource Free}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Availability}" Value="{x:Static core:PortAvailability.InUse}">
                                                        <Setter Property="Text" Value="In use" />
                                                        <Setter Property="Foreground" Value="{StaticResource Busy}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Availability}" Value="{x:Static core:PortAvailability.Error}">
                                                        <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="No COM ports found on this machine."
                           Style="{StaticResource Caption}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding Ports.Count, Converter={StaticResource ZeroToVisibility}}" />
            </Grid>
        </Border>

        <!-- Port detail pane -->
        <Border Grid.Row="1" Grid.Column="1"
                Width="300"
                Margin="12,0,0,0"
                Padding="16"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding SelectedPort, Converter={StaticResource NullToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding SelectedPort}">
                    <TextBlock Text="{Binding PortName}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />

                    <TextBlock Text="DEVICE" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding FriendlyName, Converter={StaticResource EmptyText}}" Style="{StaticResource DetailValue}" />

                    <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding Description, Converter={StaticResource EmptyText}}" Style="{StaticResource DetailValue}" />

                    <TextBlock Text="MANUFACTURER" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding Manufacturer, Converter={StaticResource EmptyText}}" Style="{StaticResource DetailValue}" />

                    <TextBlock Text="USB VID / PID" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource DetailValue}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} / {1}">
                                <Binding Path="VendorId" TargetNullValue="—" />
                                <Binding Path="ProductId" TargetNullValue="—" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock Text="DRIVER STATUS" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding Status, Converter={StaticResource EmptyText}}" Style="{StaticResource DetailValue}" />

                    <TextBlock Text="PNP DEVICE ID" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding DeviceId, Converter={StaticResource EmptyText}}"
                               Style="{StaticResource DetailValue}"
                               FontFamily="Consolas"
                               FontSize="11" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Row="2" Grid.ColumnSpan="2"
                      Height="10"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      ResizeBehavior="PreviousAndNext" />

        <!-- Module scan and live data, side by side -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="330" />
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid DataContext="{Binding Scan}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- What the scan covers stays up here; what starts it lives in the footer -->
                <WrapPanel Grid.Row="0" Margin="16,14,16,10" Orientation="Horizontal" VerticalAlignment="Center"
                           IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}">
                        <!-- Each label travels with its own control, so a wrap never strands a label on the
                             line above the field it names. -->
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource PanelTitle}" Margin="0,0,18,4" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <TextBlock Text="BAUD" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding BaudRateOptions}"
                                      SelectedItem="{Binding BaudRate}"
                                      Width="82"
                                      VerticalContentAlignment="Center" />
                        </StackPanel>

                        <CheckBox Content="All baud rates"
                                  IsChecked="{Binding AllBaudRates}"
                                  ToolTip="Sweeps every standard rate. Nine times longer."
                                  Margin="0,0,16,4" />

                        <CheckBox Content="Checksum bus"
                                  IsChecked="{Binding TryChecksum}"
                                  ToolTip="Also sweep with checksums enabled. HC2's checksum is not yet verified against hardware — treat a hit here as provisional." />
                </WrapPanel>

                <!-- Progress -->
                <StackPanel Grid.Row="1" Margin="16,0,16,10">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,0,0,6" />

                    <ProgressBar Height="4"
                                 Minimum="0" Maximum="1"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Foreground="{StaticResource Accent}"
                                 Background="{StaticResource SurfaceAlt}"
                                 BorderThickness="0" />
                </StackPanel>

                <!-- Results -->
                <Grid Grid.Row="2">
                    <DataGrid ItemsSource="{Binding Results}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource Border}"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="Transparent"
                              SelectionMode="Single"
                              CanUserResizeRows="False"
                              RowHeight="28">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hex" Binding="{Binding Address}" Width="52" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Dec" Binding="{Binding AddressDecimal}" Width="52" />
                            <DataGridTextColumn Header="Module" Binding="{Binding Model}" Width="*" MinWidth="110" />
                            <DataGridTextColumn Header="Ch" Binding="{Binding Channels}" Width="46" />
                            <DataGridTextColumn Header="Baud" Binding="{Binding BaudRate}" Width="82" />
                            <DataGridTextColumn Header="Checksum" Binding="{Binding Checksum}" Width="84" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="No scan results yet."
                               Style="{StaticResource Caption}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibility}}" />
                </Grid>

                <!-- Range, timeout and the controls that run a scan -->
                <Border Grid.Row="3"
                        Background="{StaticResource SurfaceAlt}"
                        BorderBrush="{StaticResource Border}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,5,5"
                        Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                   IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                                <TextBlock Text="ADDRESSES" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding FirstAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SmallInput}" />
                                <TextBlock Text="to" Style="{StaticResource FieldLabel}" Margin="6,0" />
                                <TextBox Text="{Binding LastAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SmallInput}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,2">
                                <TextBlock Text="TIMEOUT ms" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ProbeTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SmallInput}" />
                            </StackPanel>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Cancel"
                                    Command="{Binding CancelCommand}"
                                    Background="{StaticResource Bad}"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

                            <Button Content="Scan" Command="{Binding ScanCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="10"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ResizeBehavior="PreviousAndNext" />

        <Border Grid.Column="2"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid DataContext="{Binding Live}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Live toolbar -->
                <Grid Grid.Row="0" Margin="8,12,8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Channel values" Style="{StaticResource PanelTitle}" Margin="0,0,18,4" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                            <TextBlock Text="INTERVAL ms" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SmallInput}"
                                     IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding Cycles, StringFormat={}{0:N0} cycles}" Margin="0,0,14,4" />
                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="{Binding Failures, StringFormat={}{0:N0} failed reads}" Margin="0,0,0,4" />
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Stop"
                                Command="{Binding StopCommand}"
                                Background="{StaticResource Bad}"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

                        <Button Content="Start" Command="{Binding StartCommand}" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource Caption}" Margin="8,0,8,10" />

                <Grid Grid.Row="2">
                    <DataGrid ItemsSource="{Binding Channels}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource Border}"
                              BorderThickness="0"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="Transparent"
                              SelectionMode="Single"
                              CanUserResizeRows="False"
                              RowHeight="26">
                        <DataGrid.Columns>
                            <!-- The address is already part of the module label, so it does not get a column
                                 of its own in a panel this narrow. -->
                            <DataGridTextColumn Header="Module" Binding="{Binding ModuleLabel}" Width="*" MinWidth="110" />
                            <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="44" />

                            <DataGridTextColumn Header="Value" Binding="{Binding Display}" Width="92"
                                                FontWeight="SemiBold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Margin" Value="0,0,10,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="State" Width="98">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock ToolTip="{Binding Detail}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding State}" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="OK">
                                                            <Setter Property="Foreground" Value="{StaticResource Free}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Under range">
                                                            <Setter Property="Foreground" Value="{StaticResource Busy}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Error">
                                                            <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Run a module scan, then start reading."
                               Style="{StaticResource Caption}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding Channels.Count, Converter={StaticResource ZeroToVisibility}}" />
                </Grid>
            </Grid>
        </Border>

        </Grid>

        <!-- Status bar -->
        <DockPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="2,10,2,0">
            <TextBlock DockPanel.Dock="Right"
                       Style="{StaticResource Caption}"
                       Text="{Binding Ports.Count, StringFormat={}{0} port(s)}" />

            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
        </DockPanel>
    </Grid>
</Window>
