<Window x:Class="HC2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:HC2.App.Converters"
        Title="HC2 — COM Port Explorer"
        Height="720" Width="1160"
        MinHeight="500" MinWidth="860"
        Background="{StaticResource SurfaceAlt}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
        <conv:InverseBooleanConverter x:Key="Not" />
        <conv:EnumDescriptionConverter x:Key="EnumDescription" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- One template for every ribbon tab: each option is a tick that widens the search. -->
        <DataTemplate x:Key="OptionTemplate">
            <CheckBox Content="{Binding Label}"
                      IsChecked="{Binding IsSelected}"
                      ToolTip="{Binding Description}"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      Margin="0,0,18,0" />
        </DataTemplate>

        <ItemsPanelTemplate x:Key="OptionPanel">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
        </ItemsPanelTemplate>

        <Style x:Key="RibbonScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="SmallInput" TargetType="TextBox">
            <Setter Property="Width" Value="52" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Port settings: the search space, plus the range a scan covers -->
        <Border Grid.Row="0"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,10,16,12"
                Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" />

                    <CheckBox DockPanel.Dock="Right"
                              Content="Auto-refresh on device change"
                              IsChecked="{Binding AutoRefresh}"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0" />

                    <TextBlock Text="Port Settings" Style="{StaticResource PanelTitle}" />
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Each tab is one dimension of the search. Ticks are cumulative: a scan tries every
                         combination of the ticked ports, rates, checksum modes and framings. -->
                    <TabControl Grid.Column="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                DataContext="{Binding PortSettings}">
                        <TabItem Header="COM Port">
                            <ScrollViewer Style="{StaticResource RibbonScroll}">
                                <ItemsControl ItemsSource="{Binding ComPorts}"
                                              ItemTemplate="{StaticResource OptionTemplate}"
                                              ItemsPanel="{StaticResource OptionPanel}" />
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Baudrate">
                            <ScrollViewer Style="{StaticResource RibbonScroll}">
                                <ItemsControl ItemsSource="{Binding BaudRates}"
                                              ItemTemplate="{StaticResource OptionTemplate}"
                                              ItemsPanel="{StaticResource OptionPanel}" />
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Checksum">
                            <ScrollViewer Style="{StaticResource RibbonScroll}"
                                          ToolTip="HC2's checksum is not yet verified against hardware — treat a hit with it enabled as provisional.">
                                <ItemsControl ItemsSource="{Binding ChecksumModes}"
                                              ItemTemplate="{StaticResource OptionTemplate}"
                                              ItemsPanel="{StaticResource OptionPanel}" />
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Format">
                            <ScrollViewer Style="{StaticResource RibbonScroll}">
                                <ItemsControl ItemsSource="{Binding Formats}"
                                              ItemTemplate="{StaticResource OptionTemplate}"
                                              ItemsPanel="{StaticResource OptionPanel}" />
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Protocol">
                            <ScrollViewer Style="{StaticResource RibbonScroll}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding ProtocolOptions}"
                                              SelectedItem="{Binding Protocol}"
                                              Width="118"
                                              VerticalContentAlignment="Center"
                                              Margin="0,0,14,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumDescription}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>

                                        <!-- Without this the item reports its enum member name to
                                             accessibility tools while showing the readable one. -->
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="AutomationProperties.Name"
                                                        Value="{Binding Converter={StaticResource EnumDescription}}" />
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>

                                    <!-- Visibility comes only from the style: a local value beats a style
                                         trigger, and the warning would then never hide. -->
                                    <TextBlock Text="{Binding ProtocolWarning}" TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Setter Property="Foreground" Value="{StaticResource Busy}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSupportedProtocol}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Column="1"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="1,0,0,0"
                            Margin="14,4,0,0" />

                    <!-- The range a scan walks, kept beside the ribbons rather than inside them: it is not a
                         dimension of the search, it is how far along each one the sweep runs. -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="14,4,0,0"
                                DataContext="{Binding Scan}"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}">
                        <TextBlock Text="Scan Range" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Start" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding FirstAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SmallInput}" Margin="0,0,14,0" />

                            <TextBlock Text="End" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding LastAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SmallInput}" Margin="0,0,14,0" />

                            <Border BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0"
                                    Margin="0,0,14,0" Height="20" />

                            <TextBlock Text="Timeout" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding ProbeTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SmallInput}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Module scan and live data, side by side -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid DataContext="{Binding Scan}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding Headline}"
                               Style="{StaticResource PanelTitle}"
                               Margin="16,14,16,10" />

                    <!-- Results -->
                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding Results}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource Border}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="Transparent"
                                  SelectionMode="Single"
                                  CanUserResizeRows="False"
                                  RowHeight="28">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="58" />
                                <DataGridTextColumn Header="Hex" Binding="{Binding Address}" Width="46" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Dec" Binding="{Binding AddressDecimal}" Width="46" />
                                <DataGridTextColumn Header="Module" Binding="{Binding Model}" Width="*" MinWidth="100" />
                                <DataGridTextColumn Header="Ch" Binding="{Binding Channels}" Width="40" />
                                <DataGridTextColumn Header="Baud" Binding="{Binding BaudRate}" Width="76" />
                                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="60" />
                                <DataGridTextColumn Header="Checksum" Binding="{Binding Checksum}" Width="78" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="No scan results yet."
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Results.Count, Converter={StaticResource ZeroToVisibility}}" />
                    </Grid>

                    <!-- Progress and the controls that run a scan -->
                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceAlt}"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,5,5"
                            Padding="16,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,0,0,6" />

                            <!-- Track takes the border colour, not the surface tint: the footer is already
                                 tinted, so a SurfaceAlt track would be invisible against it. -->
                            <ProgressBar Height="4"
                                         Minimum="0" Maximum="1"
                                         Value="{Binding Progress, Mode=OneWay}"
                                         Foreground="{StaticResource Accent}"
                                         Background="{StaticResource Border}"
                                         BorderThickness="0"
                                         Margin="0,0,0,10" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Command="{Binding CancelCommand}"
                                        Background="{StaticResource Bad}"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />

                                <Button Content="Scan" Command="{Binding ScanCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="10"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid DataContext="{Binding Live}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Live toolbar -->
                    <Grid Grid.Row="0" Margin="8,12,8,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Channel values" Style="{StaticResource PanelTitle}" Margin="0,0,18,4" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                <TextBlock Text="INTERVAL ms" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SmallInput}"
                                         IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="{Binding Cycles, StringFormat={}{0:N0} cycles}" Margin="0,0,14,4" />
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="{Binding Failures, StringFormat={}{0:N0} failed reads}" Margin="0,0,0,4" />
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Stop"
                                    Command="{Binding StopCommand}"
                                    Background="{StaticResource Bad}"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

                            <Button Content="Start" Command="{Binding StartCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding Status}" Style="{StaticResource Caption}" Margin="8,0,8,10" />

                    <Grid Grid.Row="2">
                        <DataGrid ItemsSource="{Binding Channels}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource Border}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="Transparent"
                                  SelectionMode="Single"
                                  CanUserResizeRows="False"
                                  RowHeight="26">
                            <DataGrid.Columns>
                                <!-- The address is already part of the module label, so it does not get a
                                     column of its own in a panel this narrow. -->
                                <DataGridTextColumn Header="Module" Binding="{Binding ModuleLabel}" Width="*" MinWidth="110" />
                                <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="44" />

                                <DataGridTextColumn Header="Value" Binding="{Binding Display}" Width="92"
                                                    FontWeight="SemiBold">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="Margin" Value="0,0,10,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="State" Width="98">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock ToolTip="{Binding Detail}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding State}" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="OK">
                                                                <Setter Property="Foreground" Value="{StaticResource Free}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Under range">
                                                                <Setter Property="Foreground" Value="{StaticResource Busy}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Error">
                                                                <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Run a module scan, then start reading."
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Channels.Count, Converter={StaticResource ZeroToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <DockPanel Grid.Row="2" Margin="2,10,2,0">
            <TextBlock DockPanel.Dock="Right"
                       Style="{StaticResource Caption}"
                       Text="{Binding PortSettings.ComPorts.Count, StringFormat={}{0} port(s)}" />

            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
        </DockPanel>
    </Grid>
</Window>
